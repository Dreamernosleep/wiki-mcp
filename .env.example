# ============================================
# Wiki MCP - Environment Configuration
# ============================================
# Copy this file to .env and customize

# Meilisearch
# Generate a secure key: openssl rand -hex 32
MEILISEARCH_KEY=change_me_in_production_use_openssl_rand_hex_32
MEILI_ENV=production

# Ports
API_PORT=3000
UI_PORT=80

# CORS - Restrict this in production!
# CORS_ORIGIN=https://your-domain.com
CORS_ORIGIN=*

# MCP Transport
# - "http" for Docker/remote agents (Claude Code, etc.)
# - "stdio" for local agents (pi, Claude Desktop spawn locally)
MCP_TRANSPORT=http
