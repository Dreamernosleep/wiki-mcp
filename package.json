{
  "name": "wiki-mcp",
  "version": "1.0.0",
  "description": "Open source company wiki with MCP server, smart search, and web UI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx src/test.ts",
    "test:mcp": "tsx src/client-test.ts",
    "sync": "tsx src/sync.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": ["wiki", "mcp", "knowledge-base", "markdown", "search", "ai"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "meilisearch": "^0.37.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
